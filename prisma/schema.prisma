generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SYSTEM_ADMIN
  ADVISOR
  CLIENT_EXECUTIVE
  CLIENT_STAKEHOLDER
  INVESTOR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(ADVISOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  preferences Json?

  organizations   UserOrganization[]
  sessions        AssessmentSession[]
  requestedAssessmentTasks AssessmentTask[] @relation("TaskRequester")
  assignedAssessmentTasks AssessmentTask[] @relation("TaskAssignee")
  completedAssessmentTasks AssessmentTask[] @relation("TaskCompleter")
  createdPlanningItems PlanningItem[] @relation("PlanningItemCreator")
  approvedPlanningItems PlanningItem[] @relation("PlanningItemApprover")
  createdCommunicationPacks CommunicationPack[] @relation("CommunicationPackCreator")
  reviewedCommunicationPacks CommunicationPack[] @relation("CommunicationPackReviewer")
  communicationPackAcknowledgements CommunicationPackAcknowledgement[] @relation("CommunicationPackActor")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  size      String?
  notes     String?
  engagementMotive String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        UserOrganization[]
  domains      BusinessDomain[]
  stakeholders Stakeholder[]
  kpis         KPI[]
  achievements Achievement[]
  technologies Technology[]
  processes    Process[]
  projects     Project[]
  sessions       AssessmentSession[]
  capturedInputs CapturedInput[]
  recommendations Recommendation[]
  maturityRubrics MaturityRubric[]
  assessmentTasks AssessmentTask[]
  planningItems PlanningItem[]
  communicationPacks CommunicationPack[]
  inboundEmailEndpoint InboundEmailEndpoint?
}

model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole @default(CLIENT_EXECUTIVE)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model BusinessDomain {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities Capability[]
}

model Capability {
  id          String   @id @default(cuid())
  domainId    String
  name        String
  aliases     String[] @default([])
  description String?
  dimensions  String[] @default([])
  metrics     String[] @default([])
  tags        String[] @default([])

  importanceScore Float? @default(5)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domain       BusinessDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  stakeholders CapabilityStakeholder[]
  kpis         CapabilityKPI[]
  processes    CapabilityProcess[]
  technologies CapabilityTechnology[]
  projects     ProjectCapability[]
  maturityAssessments MaturityAssessment[]
  assessmentDecisions AssessmentDecision[]
  approvedInsights ApprovedInsight[]
  maturityPerspectives MaturityPerspective[]
  maturityProposals    MaturityProposal[]
  targetMaturities     TargetMaturity[]
  kpiCeilings          CapabilityKPIMaturityCeiling[]
  followUpSuggestions FollowUpSuggestion[]
}

model Stakeholder {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  role           String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities  CapabilityStakeholder[]
  perspectives  MaturityPerspective[]
  achievements  AchievementStakeholder[]
}

model CapabilityStakeholder {
  capabilityId  String
  stakeholderId String

  capability  Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@id([capabilityId, stakeholderId])
}

model KPI {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  description          String?
  targetValue          String?
  currentValue         String?
  measurementFrequency String?
  dataSource           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities CapabilityKPI[]
  capabilityCeilings CapabilityKPIMaturityCeiling[]
}

model CapabilityKPI {
  capabilityId String
  kpiId        String

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  kpi        KPI        @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@id([capabilityId, kpiId])
}

model Process {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  maturityLevel  Int?     @default(1)
  documentation  String?
  effectiveness  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities CapabilityProcess[]
}

model CapabilityProcess {
  capabilityId String
  processId    String

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  process    Process    @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@id([capabilityId, processId])
}

model Technology {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  category       String?
  status         String?
  effectiveness  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities CapabilityTechnology[]
}

model CapabilityTechnology {
  capabilityId String
  technologyId String

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  technology Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([capabilityId, technologyId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  objective      String?
  status         String   @default("planned")
  timeline       String?
  resources      String?
  outcomes       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilities ProjectCapability[]
}

model ProjectCapability {
  projectId        String
  capabilityId     String
  projectedImpact  Float?
  actualImpact     Float?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([projectId, capabilityId])
}

model Achievement {
  id             String    @id @default(cuid())
  organizationId String
  description    String
  targetDate     DateTime?
  priority       Int?      @default(5)
  successMetrics String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stakeholders AchievementStakeholder[]
}

model AchievementStakeholder {
  achievementId String
  stakeholderId String

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  @@id([achievementId, stakeholderId])
}

model AssessmentSession {
  id             String    @id @default(cuid())
  organizationId String
  advisorId      String
  name           String?
  status         String    @default("active")
  notes          String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  advisor       User            @relation(fields: [advisorId], references: [id])
  capturedInputs CapturedInput[]
  followUpSuggestions FollowUpSuggestion[]
}

enum InputType {
  AUDIO
  TEXT_NOTE
  EMAIL
  DOCUMENT
  DATA_ROOM_FILE
}

enum ProcessingStatus {
  PENDING
  TRANSCRIBING
  TRANSCRIBED
  SEGMENTING
  TAGGING
  TAGGED
  FAILED
  QUARANTINED
}

model CapturedInput {
  id             String            @id @default(cuid())
  organizationId String
  sessionId      String?
  type           InputType
  sourceRef      String?
  senderEmail    String?
  senderName     String?
  subject        String?
  idempotencyKey String?
  quarantineReason String?
  rawText        String?
  locationTag    String?
  status         ProcessingStatus  @default(PENDING)
  error          String?
  capturedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session      AssessmentSession? @relation(fields: [sessionId], references: [id])
  segments     CapturedSegment[]
  attachments  CapturedInputAttachment[]

  @@unique([organizationId, idempotencyKey])
}

model CapturedInputAttachment {
  id             String   @id @default(cuid())
  capturedInputId String
  filename       String
  contentType    String
  sizeBytes      Int?
  sourceRef      String?
  createdAt      DateTime @default(now())
  capturedInput  CapturedInput @relation(fields: [capturedInputId], references: [id], onDelete: Cascade)
}

model InboundEmailEndpoint {
  id             String   @id @default(cuid())
  organizationId String   @unique
  addressKey     String   @unique
  inboundAddress String   @unique
  tokenHash      String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CapturedSegment {
  id              String   @id @default(cuid())
  capturedInputId String
  order           Int
  speaker         String?
  text            String
  startMs         Int?
  endMs           Int?
  createdAt       DateTime @default(now())

  capturedInput CapturedInput @relation(fields: [capturedInputId], references: [id], onDelete: Cascade)
  tags          Tag[]
  followUps FollowUpSuggestion[]
}

enum TagTargetType {
  DOMAIN
  CAPABILITY
  KPI
  STAKEHOLDER
}

enum TagStatus {
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
  REASSIGNED
}

model Tag {
  id         String        @id @default(cuid())
  segmentId  String
  targetType TagTargetType
  targetId   String
  confidence Float
  status     TagStatus     @default(PENDING_REVIEW)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime      @default(now())

  segment CapturedSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
}

model MaturityRubric {
  id             String   @id @default(cuid())
  organizationId String?
  name           String
  version        Int
  anchors        Json
  isDefault      Boolean  @default(false)
  effectiveFrom  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name, version])
  @@index([organizationId, isDefault])
}

model MaturityPerspective {
  id                String   @id @default(cuid())
  capabilityId      String
  stakeholderId     String?
  assessorEmail     String?
  stakeholderType   String
  assessorRole      String?
  locationTag       String?
  score             Float
  scoreRangeMin     Float?
  scoreRangeMax     Float?
  originalStatement String
  rationale         String?
  confidence        Float?
  sourceEvidenceIds String[] @default([])
  rubricVersion     Int?
  status            String   @default("SUBMITTED")
  reviewedBy       String?
  reviewNotes      String?
  reviewedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  capability  Capability  @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  stakeholder Stakeholder? @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)

  @@index([capabilityId, createdAt])
  @@index([capabilityId, stakeholderType])
}

model MaturityProposal {
  id                  String   @id @default(cuid())
  capabilityId        String
  proposalType        String
  interpretation      String
  suggestedScore      Float?
  scoreRangeMin       Float?
  scoreRangeMax       Float?
  confidence          Float?
  missingEvidence     String[] @default([])
  conflictingEvidence String[] @default([])
  sourceEvidenceIds   String[] @default([])
  sourcePerspectiveIds String[] @default([])
  status              String   @default("PENDING_REVIEW")
  reviewedBy          String?
  reviewNotes         String?
  reviewedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId, status, createdAt])
}

model MaturityAssessment {
  id               String   @id @default(cuid())
  capabilityId     String
  locationTag      String?
  score            Int
  evidence         String?
  sourceSegmentIds String[]
  assessedBy       String?
  assessedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId, locationTag, assessedAt])
}

model AssessmentDecision {
  id                   String   @id @default(cuid())
  capabilityId         String
  status               String
  score                Float?
  scoreRangeMin        Float?
  scoreRangeMax        Float?
  rationale            String?
  rubricVersion        Int?
  sourceEvidenceIds    String[] @default([])
  sourcePerspectiveIds String[] @default([])
  decidedBy            String?
  decidedAt            DateTime @default(now())
  supersedesId         String?
  createdAt            DateTime @default(now())

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  approvedInsights ApprovedInsight[]
  communicationPacks CommunicationPack[]

  @@index([capabilityId, createdAt])
  @@index([supersedesId])
}

model ApprovedInsight {
  id                   String   @id @default(cuid())
  capabilityId         String
  decisionId           String
  type                 String
  title                String
  description          String
  priority             Float?
  status               String   @default("APPROVED")
  sourceEvidenceIds    String[] @default([])
  sourcePerspectiveIds String[] @default([])
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  decision   AssessmentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  growthActions GrowthAction[]
  planningItems PlanningItem[]
  communicationPacks CommunicationPack[]

  @@index([capabilityId, createdAt])
  @@index([decisionId])
}

model GrowthAction {
  id          String   @id @default(cuid())
  insightId   String
  title       String
  description String
  outcomeScenario String @default("PROFIT_GROWTH")
  expectedValue Float?
  valueAssumptions String?
  ownerEmail  String?
  dueDate     DateTime?
  priority    Int?     @default(5)
  status      String   @default("PLANNED")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  insight ApprovedInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  recommendation Recommendation?

  @@index([insightId, status])
  @@index([ownerEmail, status])
}


enum PlanningItemType {
  REQUIREMENT
  SPECIFICATION
  GOAL
  OBJECTIVE
}

enum PlanningItemLifecycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanningItemApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model PlanningItem {
  id                  String                    @id @default(cuid())
  organizationId      String
  type                PlanningItemType
  title               String
  description         String
  ownerEmail          String?
  targetDate          DateTime?
  lifecycleStatus     PlanningItemLifecycleStatus @default(DRAFT)
  humanApprovalState  PlanningItemApprovalState @default(NOT_REQUIRED)
  createdBy           String?
  approvedBy          String?
  createdAt           DateTime                  @default(now())
  approvedAt          DateTime?
  updatedAt           DateTime                  @updatedAt
  parentId            String?
  approvedInsightId   String?

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator             User?                     @relation("PlanningItemCreator", fields: [createdBy], references: [email], onDelete: SetNull)
  approver            User?                     @relation("PlanningItemApprover", fields: [approvedBy], references: [email], onDelete: SetNull)
  parent              PlanningItem?             @relation("PlanningItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children            PlanningItem[]            @relation("PlanningItemHierarchy")
  approvedInsight     ApprovedInsight?          @relation(fields: [approvedInsightId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, lifecycleStatus])
  @@index([organizationId, targetDate])
  @@index([parentId])
  @@index([approvedInsightId])
}

model CommunicationPack {
 id String @id @default(cuid())
 organizationId String
 decisionId String?
 insightId String?
 recipientContext Json
 stakeholderContext Json
 title String
 content String
 status CommunicationPackStatus @default(DRAFT)
 createdBy String
 reviewedBy String?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
 decision AssessmentDecision? @relation(fields: [decisionId], references: [id], onDelete: Restrict)
 insight ApprovedInsight? @relation(fields: [insightId], references: [id], onDelete: Restrict)
 creator User @relation("CommunicationPackCreator", fields: [createdBy], references: [email], onDelete: Restrict)
 reviewer User? @relation("CommunicationPackReviewer", fields: [reviewedBy], references: [email], onDelete: SetNull)
 acknowledgements CommunicationPackAcknowledgement[]
 @@index([organizationId, status, createdAt])
 @@index([decisionId])
 @@index([insightId])
}

enum CommunicationPackStatus {
 DRAFT
 READY_FOR_REVIEW
 CHANGES_REQUESTED
 APPROVED_FOR_DISTRIBUTION
 ACKNOWLEDGED
}

enum CommunicationPackAction {
 SUBMITTED
 REQUEST_CHANGES
 APPROVED
 ACKNOWLEDGED
}

model CommunicationPackAcknowledgement {
 id String @id @default(cuid())
 communicationPackId String
 action CommunicationPackAction
 note String?
 actedBy String
 createdAt DateTime @default(now())
 communicationPack CommunicationPack @relation(fields: [communicationPackId], references: [id], onDelete: Cascade)
 actor User @relation("CommunicationPackActor", fields: [actedBy], references: [email], onDelete: Restrict)
 @@index([communicationPackId, createdAt])
}

model TargetMaturity {
  id                String   @id @default(cuid())
  capabilityId      String
  locationTag       String?
  score             Int
  rationale         String?
  committedBy       String?
  source            String   @default("manual")
  sourceSegmentIds  String[] @default([])
  setBy             String?
  setAt             DateTime @default(now())
  createdAt         DateTime @default(now())

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId, locationTag, setAt])
}

model CapabilityKPIMaturityCeiling {
  id               String  @id @default(cuid())
  capabilityId     String
  kpiId            String
  maturityLevel    Int
  targetCeilingMin Float?
  targetCeilingMax Float?
  valueToNextLevel Float?
  notes            String?

  capability Capability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  kpi        KPI        @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, kpiId, maturityLevel])
}

enum DependencyType {
  CAPABILITY_TO_KPI
  KPI_TO_KPI
  CAPABILITY_TO_CAPABILITY
}

model Dependency {
  id          String         @id @default(cuid())
  type        DependencyType
  sourceType  TagTargetType
  sourceId    String
  targetType  TagTargetType
  targetId    String
  description String?
  createdAt   DateTime       @default(now())

  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

model ConflictFlag {
  id         String         @id @default(cuid())
  entityType TagTargetType
  entityId   String
  status     ConflictStatus @default(OPEN)
  claims     Json
  resolution String?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime       @default(now())

  @@index([entityType, entityId])
}

enum RecommendationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  EDITED
}

model Recommendation {
  id                    String                @id @default(cuid())
  organizationId        String
  title                 String
  description           String
  relatedCapabilityIds  String[]
  relatedKPIIds         String[]
  estimatedValue        Float?
  priorityScore         Float?
  status                RecommendationStatus  @default(DRAFT)
  reviewedBy            String?
  reviewNotes           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feedback          RecommendationFeedback[]
  sourceGrowthActionId String? @unique
  sourceGrowthAction GrowthAction? @relation(fields: [sourceGrowthActionId], references: [id], onDelete: SetNull)
}

model RecommendationFeedback {
  id               String   @id @default(cuid())
  recommendationId String
  action           String
  originalFields   Json?
  editedFields     Json?
  reason           String?
  actedBy          String?
  actedAt          DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

enum FollowUpStatus {
  SHOWN
  ASKED
  DISMISSED
}

model FollowUpSuggestion {
  id                String         @id @default(cuid())
  sessionId         String
  triggerSegmentId  String?
  capabilityId      String?
  suggestedQuestion String
  status            FollowUpStatus @default(SHOWN)
  createdAt         DateTime       @default(now())

  session        AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerSegment CapturedSegment?  @relation(fields: [triggerSegmentId], references: [id])
  capability     Capability?       @relation(fields: [capabilityId], references: [id])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

model ProcessingJob {
  id        String    @id @default(cuid())
  type      String
  targetId  String
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


enum AssessmentTaskType {
  EVIDENCE_REQUEST
  INTERVIEW
  FOLLOW_UP
  VALIDATION
  REVIEW
  SIGN_OFF
  REPORT_PREPARATION
}

enum AssessmentTaskStatus {
  OPEN
  AWAITING_INPUT
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum AssessmentTaskReviewState {
  NOT_REQUIRED
  PENDING_HUMAN_REVIEW
  APPROVED
  REJECTED
}

model AssessmentTask {
  id              String                    @id @default(cuid())
  organizationId  String
  requesterId     String
  assigneeId      String
  type            AssessmentTaskType
  title           String
  description     String
  context         String?
  dueDate         DateTime
  priority        Int                       @default(3)
  status          AssessmentTaskStatus      @default(OPEN)
  humanReviewState AssessmentTaskReviewState @default(NOT_REQUIRED)
  linkedEvidenceId String?
  linkedCapabilityId String?
  linkedDecisionId String?
  linkedReportSection String?
  completedAt     DateTime?
  completedById   String?
  completionNote  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester User @relation("TaskRequester", fields: [requesterId], references: [id])
  assignee User @relation("TaskAssignee", fields: [assigneeId], references: [id])
  completedBy User? @relation("TaskCompleter", fields: [completedById], references: [id])

  @@index([organizationId, status, dueDate])
  @@index([assigneeId, status])
}
